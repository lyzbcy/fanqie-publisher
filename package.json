{
  "name": "fanqie-publisher",
  "version": "1.2.1",
  "description": "番茄小说长篇章节拆分、预检与安全发布工具",
  "main": "src/index.js",
  "bin": {
    "fanqie": "./bin/fanqie.js"
  },
  "scripts": {
    "test": "node --check src/publish-chapter.js && node --check src/prepare-novel.js && node --check src/publish-remaining.js && node --test tests/*.test.cjs",
    "skill:install": "node scripts/install-skill.cjs",
    "skill:update": "node scripts/self-update.cjs",
    "prepare:novel": "node src/prepare-novel.js",
    "publish:remaining": "node src/publish-remaining.js",
    "publish:example": "node examples/basic.js"
  },
  "keywords": [
    "fanqie",
    "fanqienovel",
    "publisher",
    "automation",
    "browser",
    "novel",
    "diary",
    "ai"
  ],
  "author": "lyzbcy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lyzbcy/fanqie-publisher.git"
  },
  "bugs": {
    "url": "https://github.com/lyzbcy/fanqie-publisher/issues"
  },
  "homepage": "https://github.com/lyzbcy/fanqie-publisher#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "playwright": "^1.63.0"
  }
}
